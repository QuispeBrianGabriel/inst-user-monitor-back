# syntax=docker/dockerfile:1

# ----- build: compilación del binario -----
# Versión de Rust: mantener igual en rust-toolchain.toml y Dockerfile.dev.
# No se copia rust-toolchain.toml: la imagen ya trae esa versión, y así rustup
# no descarga componentes (rustfmt, clippy) que aquí no hacen falta.
FROM rust:1.100.0-slim-trixie AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY migration/Cargo.toml migration/
# Capa de dependencias: solo se recompila si cambian los Cargo.toml o Cargo.lock.
# Con el cache del registry (release.yml) esta capa se reutiliza entre releases.
# Fuentes ficticias con la misma forma que las reales (bin + lib + migration).
RUN mkdir -p src/bin migration/src \
    && echo 'fn main() {}' > src/bin/main.rs \
    && touch src/lib.rs migration/src/lib.rs \
    && cargo build --release --locked \
    && rm -rf src migration/src
COPY src src
COPY migration/src migration/src
# touch: cargo compara mtimes y el build ficticio podría parecer más reciente
RUN touch src/bin/main.rs src/lib.rs migration/src/lib.rs \
    && cargo build --release --locked \
    && cp target/release/inst_user_monitor_back-cli /server

# ----- prod: imagen final mínima (solo glibc, sin shell, no-root) -----
FROM gcr.io/distroless/cc-debian13:nonroot AS prod
COPY --from=build /server /server
# Loco lee config/<LOCO_ENV>.yaml; los secretos llegan por variables de entorno
# (ver config/production.yaml).
COPY config/production.yaml /config/production.yaml
ENV LOCO_ENV=production \
    LOCO_CONFIG_FOLDER=/config \
    PORT=8080
EXPOSE 8080
# `docker run <imagen>` aplica las migraciones pendientes y atiende peticiones
# (DB_AUTO_MIGRATE, ver config/production.yaml). Con varias réplicas se migra
# aparte, una vez por release (en Railway, el pre-deploy command):
# `docker run <imagen> /server db migrate`.
# Sin ENTRYPOINT a propósito: así un comando de la plataforma
# (`/server db migrate`) funciona igual la sustituya o no; y en forma exec,
# porque la imagen no tiene shell.
CMD ["/server", "start"]
