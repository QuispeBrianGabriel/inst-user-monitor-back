# Copiar a .env junto a compose.yml (ignorado por git): make setup lo hace por ti

POSTGRES_DB=inst_user_monitor
POSTGRES_USER=postgres
# Va dentro de DATABASE_URL: sin caracteres especiales de URL (make setup genera una hexadecimal)
POSTGRES_PASSWORD=change-me

# Nivel de logs de la API: error, warn, info, debug, trace
LOG_LEVEL=info

# Firma de los tokens JWT: base64 de al menos 64 bytes (make setup genera uno;
# también make jwt-secret). Si cambia, todos los tokens emitidos dejan de valer.
JWT_SECRET=change-me
# Duración del token de acceso en minutos (opcional, 15 por defecto)
JWT_TTL_MINUTES=15

# Origen(es) del frontend permitidos por CORS, separados por comas y sin barra final
CORS_ORIGIN=http://localhost:3000
